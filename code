    # =====================================
    # SEARCH TEAMS
    # =====================================

    def search_teams(self):

        query = self.search_input.text().strip()

        if not query:

            QMessageBox.warning(
                self,
                "Search",
                "Please enter a team name."
            )

            return

        self.team_list.clear()
        self.clear_team_details()

        self.status_label.setText(
            "Searching for teams..."
        )

        QApplication.processEvents()

        found_teams = {}

        try:

            data = self.sportsdb_get(
                "searchteams.php",
                {"t": query}
            )

            raw_teams = data.get("teams") or []

            if isinstance(raw_teams, dict):
                raw_teams = [raw_teams]

            elif isinstance(raw_teams, str):
                raw_teams = [raw_teams]

            if not isinstance(raw_teams, list):
                raw_teams = []

            for team in raw_teams:

                if isinstance(team, str):

                    team = {
                        "strTeam": team,
                        "strSport": self.current_sport
                    }

                if not isinstance(team, dict):
                    continue

                name = team.get("strTeam")

                if not name:
                    continue

                team_sport = team.get(
                    "strSport",
                    self.current_sport
                )

                if (
                    team_sport.lower()
                    != self.current_sport.lower()
                ):
                    continue

                found_teams[name.lower()] = team

        except RuntimeError as error:

            QMessageBox.warning(
                self,
                "API Limit",
                str(error)
            )

        except requests.RequestException as error:

            QMessageBox.warning(
                self,
                "Connection Error",
                str(error)
            )

        # Search the local NBA fallback list.

        if self.current_sport == "Basketball":

            for name in self.NBA_TEAMS:

                if query.lower() in name.lower():

                    if name.lower() not in found_teams:

                        found_teams[name.lower()] = {
                            "strTeam": name,
                            "strSport": "Basketball",
                            "strLeague": "NBA",
                            "strCountry": "USA"
                        }

        for team in sorted(
            found_teams.values(),
            key=lambda t: t["strTeam"].lower()
        ):

            item = QListWidgetItem(
                f"🏆 {team['strTeam']}"
            )

            item.setData(Qt.UserRole, team)

            self.team_list.addItem(item)

        if self.team_list.count() == 0:

            self.status_label.setText(
                "No matching teams found."
            )

        else:

            self.status_label.setText(
                f"Found {self.team_list.count()} team(s)."
            )

    # =====================================
    # DISPLAY TEAM INFORMATION
    # =====================================

    def show_team_details(self, item):

        team = item.data(Qt.UserRole)

        if not isinstance(team, dict):
            return

        name = team.get(
            "strTeam",
            "Unknown"
        )

        sport = team.get(
            "strSport",
            self.current_sport
        )

        league = team.get(
            "strLeague",
            "Not available"
        )

        stadium = team.get(
            "strStadium",
            "Not available"
        )

        country = team.get(
            "strCountry",
            "Not available"
        )

        founded = team.get(
            "intFormedYear",
            "Not available"
        )

        description = team.get(
            "strDescriptionEN",
            "No description available."
        ) or "No description available."

        self.info_label.setText(
            f"Sport: {sport}\n\n"
            f"League: {league}\n\n"
            f"Stadium: {stadium}\n\n"
            f"Country: {country}\n\n"
            f"Founded: {founded}\n\n"
            f"{description}"
        )

        self.team_name_label.setText(name)

        self.load_team_logo(
            team.get("strBadge")
        )

        self.status_label.setText(
            f"Now viewing {name}."
        )

    # =====================================
    # TEAM LOGO
    # =====================================

    def load_team_logo(self, url):

        self.logo_label.clear()

        if not url:

            self.logo_label.setText(
                "No team logo available"
            )

            return

        pixmap = self.download_image(url)

        if pixmap:

            self.logo_label.setPixmap(
                pixmap.scaled(
                    220,
                    180,
                    Qt.KeepAspectRatio,
                    Qt.SmoothTransformation
                )
            )

        else:

            self.logo_label.setText(
                "Team logo unavailable"
            )

    # =====================================
    # CLEAR TEAM INFORMATION
    # =====================================

    def clear_team_details(self):

        self.info_label.setText(
            "Select a team to view its information."
        )

        self.logo_label.setText("Team logo")

        self.team_name_label.clear()


