    # =====================================
    # LOAD TEAMS FOR SELECTED SPORT
    # =====================================

    def load_sport_teams(self, sport):

        self.team_list.clear()

        self.clear_team_details()

        self.status_label.setText(
            f"Loading {sport} teams..."
        )

        QApplication.processEvents()

        team_dictionary = {}

        try:

            data = self.sportsdb_get(
                "search_all_teams.php",
                {"s": sport}
            )

            raw_teams = data.get("teams") or []

            # FIX: Handle different API response formats.

            if isinstance(raw_teams, dict):
                raw_teams = [raw_teams]

            elif isinstance(raw_teams, str):
                raw_teams = [raw_teams]

            if not isinstance(raw_teams, list):
                raw_teams = []

            for team in raw_teams:

                # FIX: Strings do not have .get().
                # Convert strings into team dictionaries.

                if isinstance(team, str):

                    team = {
                        "strTeam": team,
                        "strSport": sport
                    }

                if not isinstance(team, dict):
                    continue

                name = team.get("strTeam")

                if name and isinstance(name, str):

                    team_dictionary[name.lower()] = team

        except RuntimeError as error:

            self.status_label.setText(str(error))

        except requests.RequestException as error:

            self.status_label.setText(
                f"API connection error: {error}"
            )

        # Add NBA fallback teams.

        if sport == "Basketball":

            for name in self.NBA_TEAMS:

                if name.lower() not in team_dictionary:

                    team_dictionary[name.lower()] = {
                        "strTeam": name,
                        "strSport": "Basketball",
                        "strLeague": "NBA",
                        "strCountry": "USA",
                        "strDescriptionEN": (
                            "Basketball team. "
                            "More information may be available "
                            "from TheSportsDB."
                        )
                    }

        # Display teams.

        sorted_teams = sorted(
            team_dictionary.values(),
            key=lambda team: team["strTeam"].lower()
        )

        for team in sorted_teams:

            item = QListWidgetItem(
                f"🏆 {team['strTeam']}"
            )

            item.setData(Qt.UserRole, team)

            self.team_list.addItem(item)

        if self.team_list.count() == 0:

            self.status_label.setText(
                f"No {sport} teams were found."
            )

        else:

            self.status_label.setText(
                f"Showing {self.team_list.count()} {sport} teams."
            )

    # =====================================
    # FAMOUS PLAYER IMAGE LOOKUP
    # =====================================

    def get_player_image(self, player_name):

        cache_key = ("player_image", player_name)

        if cache_key in self.api_cache:
            return self.api_cache[cache_key]

        image_url = None

        try:

            title = quote(
                player_name.replace(" ", "_")
            )

            response = self.session.get(
                f"https://en.wikipedia.org/api/rest_v1/page/summary/{title}",
                timeout=12
            )

            response.raise_for_status()

            data = response.json()

            image_url = (
                data.get("thumbnail", {}).get("source")
            )

        except (
            requests.RequestException,
            ValueError
        ):

            pass

        self.api_cache[cache_key] = image_url

        return image_url

